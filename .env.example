# ============================================
# Synaptic Room — Environment template
# ============================================
# Quick start:
#   1. cp .env.example .env
#   2. docker compose up --build
#
# Read by docker-compose (variable substitution) and by the server when run
# locally (it loads ../.env). The ONLY value you must supply for a working stack
# is GEMINI_API_KEY; everything else has safe local defaults.

# ── Runtime ──
NODE_ENV=development
# Frictionless local run: no auth required. Set to false (and provide real
# secrets below) for a secure run.
NEXORA_DEV_INSECURE=true

# ── Auth secrets (dev values; change for a real deployment) ──
JOIN_TOKEN_SECRET=nexora_dev_join_secret_change_me_0123456789
AGENT_API_KEY=nexora_dev_agent_api_key_change_me_0123456789
TEACHER_PASSCODE=123456

# ── Durable hot state (Phase 1) ──
# Leave EMPTY for local runs (in-memory, single instance). Docker Compose
# automatically uses the bundled redis service (redis://redis:6379).
REDIS_URL=
STATE_HOT_TTL_S=7200

# ── Networking ──
CORS_ORIGIN=http://localhost:5174
VITE_SERVER_URL=http://localhost:3001

# ── Supabase (optional persistence) ──
SUPABASE_URL=https://fvgxjksiwyqohanfjwqg.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZ2Z3hqa3Npd3lxb2hhbmZqd3FnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI0OTM0MzQsImV4cCI6MjA5ODA2OTQzNH0.Qlvvo43nnLU9hZv1q3CKHDhxtqREALdYcFx2dU-SwaM
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZ2Z3hqa3Npd3lxb2hhbmZqd3FnIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MjQ5MzQzNCwiZXhwIjoyMDk4MDY5NDM0fQ.2t6FVdLIRxrBe25ApN8lIj8W4JSIeAwb-4S8jp2bLmE

