{
  "name": "synaptic-server",
  "version": "1.0.0",
  "description": "Synaptic Room — Real-time cognitive orchestration hub for collaborative learning",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=60 --test-coverage-functions=50 --test-coverage-branches=50",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check:env-docs": "node scripts/check-env-docs.mjs",
    "bench": "node scripts/benchmark-latency.mjs"
  },
  "keywords": [
    "education",
    "ai",
    "real-time",
    "websocket",
    "collaborative-learning"
  ],
  "license": "MIT",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.49.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "ioredis-mock": "^8.9.0",
    "prettier": "^3.3.3",
    "socket.io-client": "^4.8.1"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
