# ============================================
# Synaptic Room — Backend Server Environment
# ============================================
# Copy to `.env` and fill in real values. The server validates this file at
# startup and REFUSES TO BOOT if a required secret is missing (secure by
# default). Never commit a real `.env`.
#
# Secrets are marked [SECRET] — keep them out of version control and logs.

# ── Runtime ──
PORT=3001
# development | test | production
NODE_ENV=development

# Explicit escape hatch: run WITHOUT authentication for local development only.
# Must be set to `true` on purpose; it is hard-blocked when NODE_ENV=production.
# When false/absent, the three secrets below are REQUIRED to boot.
NEXORA_DEV_INSECURE=false

# ── Auth secrets (REQUIRED unless NEXORA_DEV_INSECURE=true) ──
# [SECRET] Signs/verifies socket join tokens (HMAC-SHA256). min 16 chars.
#          Generate with: openssl rand -hex 32
JOIN_TOKEN_SECRET=
# [SECRET] Shared secret authenticating the server → AI agents channel. min 16 chars.
#          Must match AGENT_API_KEY on the agents service. openssl rand -hex 32
AGENT_API_KEY=
# [SECRET] Passcode required to join as a teacher. min 6 chars.
TEACHER_PASSCODE=

# ── AI Agent Service (FastAPI) ──
AI_AGENT_BASE_URL=http://localhost:8000
# Gemini calls routinely take 2-5s; keep this comfortably above that.
AI_AGENT_TIMEOUT_MS=15000
AI_AGENT_MAX_RETRIES=2

# ── CORS — the browser origin the client is served from ──
CORS_ORIGIN=http://localhost:5173

# ── Durable hot state (Redis) ──
# Leave blank for in-memory state (single instance / dev). Set to enable durable
# state that survives restarts and is shared across instances (horizontal scale).
REDIS_URL=
# TTL (seconds) for hot-state entities in Redis; refreshed on every save.
STATE_HOT_TTL_S=7200

# ── Supabase (OPTIONAL) ──
# Leave blank to run fully in-memory (persistence/analytics become no-ops).
# This is NOT a mock: absent means "no persistence", not "fake persistence".
SUPABASE_URL=
# [SECRET]
SUPABASE_ANON_KEY=
# [SECRET]
SUPABASE_SERVICE_ROLE_KEY=

# ── Circuit Breaker ──
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_MS=30000

# ── Trace Buffer ──
TRACE_BUFFER_WINDOW_SIZE=5
TRACE_BUFFER_FLUSH_INTERVAL_MS=3000
